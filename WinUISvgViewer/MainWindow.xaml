<Window
    x:Class="WinUISvgViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:skia="using:SkiaSharp.Views.Windows"
    Title="SVG Viewer with SkiaSharp">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Top Bar with Folder Picker -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Padding="10" Spacing="10">
            <Button x:Name="SelectFolderButton" Content="Select Folder" Click="SelectFolderButton_Click"/>
            <TextBlock x:Name="CurrentFolderText" VerticalAlignment="Center" Text="No folder selected"/>
        </StackPanel>

        <!-- Left Panel: File List -->
        <Grid Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="0,1,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="SVG Files" FontWeight="Bold" Margin="10,5"/>
            <ListBox x:Name="SvgFilesList" 
                     Grid.Row="1" 
                     SelectionChanged="SvgFilesList_SelectionChanged"
                     Margin="5"/>
        </Grid>

        <!-- Right Panel: SVG Display -->
        <Grid Grid.Row="1" Grid.Column="1" Padding="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock x:Name="CurrentFileText" 
                       Grid.Row="0" 
                       Text="No file selected" 
                       FontWeight="Bold" 
                       Margin="0,0,0,10"/>
            
            <Border Grid.Row="1" 
                    BorderBrush="LightGray" 
                    BorderThickness="1" 
                    Background="White">
                <skia:SKXamlCanvas x:Name="SkiaCanvas" 
                                   PaintSurface="SkiaCanvas_PaintSurface"/>
            </Border>
        </Grid>

        <!-- Bottom Navigation -->
        <StackPanel Grid.Row="2" Grid.Column="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Padding="10" 
                    Spacing="10">
            <Button x:Name="PreviousButton" 
                    Content="← Previous" 
                    Click="PreviousButton_Click" 
                    IsEnabled="False"/>
            <Button x:Name="NextButton" 
                    Content="Next →" 
                    Click="NextButton_Click" 
                    IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
